rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidId(studentId);
      allow delete: if isValidId(studentId);
    }

    // Teachers Collection
    match /teachers/{teacherId} {
      allow read: if true;
      allow create, update: if isValidId(teacherId);
      allow delete: if isValidId(teacherId);
    }

    // Classes Collection
    match /classes/{classId} {
      allow read: if true;
      allow create, update: if isValidId(classId);
      allow delete: if isValidId(classId);
    }

    // Academic Structure Collections
    match /majors/{majorId} {
      allow read: if true;
      allow create, update: if isValidId(majorId);
      allow delete: if isValidId(majorId);
    }

    match /generations/{generationId} {
      allow read: if true;
      allow create, update: if isValidId(generationId);
      allow delete: if isValidId(generationId);
    }

    match /academicYears/{academicYearId} {
      allow read: if true;
      allow create, update: if isValidId(academicYearId);
      allow delete: if isValidId(academicYearId);
    }

    match /yearLevels/{yearLevelId} {
      allow read: if true;
      allow create, update: if isValidId(yearLevelId);
      allow delete: if isValidId(yearLevelId);
    }

    match /semesters/{semesterId} {
      allow read: if true;
      allow create, update: if isValidId(semesterId);
      allow delete: if isValidId(semesterId);
    }

    // Attendance Records Collection
    match /attendances/{attendanceId} {
      allow read: if true;
      allow create, update: if isValidId(attendanceId);
      allow delete: if isValidId(attendanceId);
    }
  }
}
